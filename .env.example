# Get your access key from https://ipstack.com/ (required)
IPSTACK_ACCESS_KEY=your_ipstack_access_key_here

# PostgreSQL connection (used in Docker; local dev uses config/database.yml)
DATABASE_URL=postgres://postgres:password@localhost:5432/geolocation_api_development

# Rails master key (run: bundle exec rails credentials:show to get it)
RAILS_MASTER_KEY=

# CORS: comma-separated allowed origins for cross-origin requests.
# Defaults to * in development. In production, no origins are allowed unless set.
# CORS_ORIGINS=https://yourfrontend.com,https://admin.yourfrontend.com
